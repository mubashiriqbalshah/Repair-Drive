# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/repairdrive

# JWT
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# SMS Provider (twilio | mock | veevotech)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VEEVOTECH_API_KEY=
VEEVOTECH_SENDER_ID=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (for backend geocoding if needed)
GOOGLE_MAPS_API_KEY=

# Admin bootstrap (first super-admin)
SEED_ADMIN_EMAIL=admin@repairdrive.pk
SEED_ADMIN_PASSWORD=ChangeMe123!
